{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "デスクトップだけの権限。アプリの更新（updater）と、入れ替えたあとの再起動（process）",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart"
  ]
}
